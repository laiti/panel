[Unit]
Description=Panel display (X11)
After=remote-fs.target systemd-user-sessions.service network-online.target polkit.service upower.service docker.service
Wants=network-online.target polkit.service upower.service
Conflicts=getty@tty7.service

[Service]
User=panel
PAMName=login
TTYPath=/dev/tty7
Environment=WINDOWING=x11
Environment=DISPLAY=:0.0
ExecStart=/usr/bin/xinit /opt/panel/bin/panel -- :0 -nocursor -nolisten tcp vt7
Restart=always
RestartSec=1
StandardInput=tty
StandardOutput=journal

[Install]
WantedBy=graphical.target
